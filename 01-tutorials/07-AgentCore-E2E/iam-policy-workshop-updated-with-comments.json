{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AllReaperSupportedServices",
            "Comment": "Base workshop permissions for core AWS services used across all labs",
            "Action": [
                "aws-marketplace:Unsubscribe",
                "aws-marketplace:ViewSubscriptions",
                "cloudformation:*",
                "cloudtrail:*",
                "cloudwatch:*",
                "cognito-identity:*",
                "dynamodb:*",
                "es:*",
                "events:*",
                "execute-api:*",
                "lambda:*",
                "logs:*",
                "s3:*",
                "sagemaker:*",
                "sts:*",
                "tag:*",
                "xray:*",
                "codebuild:*",
                "cognito-idp:*"
            ],
            "Effect": "Allow",
            "Resource": "*"
        },
        {
            "Sid": "BedrockAgentCoreReadPermission",
            "Comment": "Basic read access to AgentCore resources - allows viewing existing resources but not creating new ones",
            "Effect": "Allow",
            "Action": [
                "bedrock-agentcore:Get*",
                "bedrock-agentcore:List*",
                "bedrock-agentcore:InvokeAgentRuntime",
                "bedrock-agentcore:ConnectBrowserAutomationStream",
                "bedrock-agentcore:ConnectBrowserLiveViewStream",
                "bedrock-agentcore:DeleteBrowser"
            ],
            "Resource": "*"
        },
        {
            "Sid": "BedrockAgentCoreObservability",
            "Comment": "Lab 4.1: Enables Transaction Search discovery in CloudWatch GenAI Observability dashboard",
            "Effect": "Allow",
            "Action": [
                "application-signals:StartDiscovery"
            ],
            "Resource": "*"
        },
        {
            "Sid": "BedrockBasicAccess",
            "Comment": "Consolidated Bedrock permissions: basic read/list operations, model invocation, resource tagging, and VPC operations for SageMaker integration",
            "Effect": "Allow",
            "Action": [
                "bedrock:Get*",
                "bedrock:List*",
                "bedrock:InvokeModel",
                "bedrock:InvokeModelWithResponseStream",
                "bedrock:PutUseCaseForModelAccess",
                "bedrock:PutModelInvocationLoggingConfiguration",
                "bedrock:TagResource",
                "bedrock:UntagResource",
                "aws-marketplace:ViewSubscriptions",
                "ec2:DescribeVpcs",
                "ec2:DescribeSubnets"
            ],
            "Resource": "*"
        },
        {
            "Sid": "BedrockModelSubscriptions",
            "Comment": "Allows subscription to approved foundation models for workshop use",
            "Effect": "Allow",
            "Action": [
                "aws-marketplace:Subscribe",
                "aws-marketplace:Unsubscribe"
            ],
            "Resource": "*",
            "Condition": {
                "ForAnyValue:StringEquals": {
                    "aws-marketplace:ProductId": [
                        "prod-cx7ovbu5wex7g",
                        "prod-5oba7y7jpji56",
                        "prod-4dlfvry4v5hbi",
                        "b7568428-a1ab-46d8-bab3-37def50f6f6a",
                        "38e55671-c3fe-4a44-9783-3584906e7cad"
                    ]
                }
            }
        },
        {
            "Sid": "DenyExpensiveResources",
            "Comment": "Cost control: Prevents purchasing reserved instances/capacity across EC2, RDS, and DynamoDB services",
            "Effect": "Deny",
            "Action": [
                "ec2:ModifyReservedInstances",
                "ec2:PurchaseHostReservation",
                "ec2:PurchaseReservedInstancesOffering",
                "ec2:PurchaseScheduledInstances",
                "rds:PurchaseReservedDBInstancesOffering",
                "dynamodb:PurchaseReservedCapacityOfferings"
            ],
            "Resource": "*"
        },
        {
            "Sid": "DenyXXLInstances",
            "Comment": "Cost control: Prevents launching expensive EC2 instance types",
            "Effect": "Deny",
            "Action": "ec2:RunInstances",
            "Resource": "arn:aws:ec2:*:*:instance/*",
            "Condition": {
                "StringLike": {
                    "ec2:InstanceType": [
                        "*6xlarge",
                        "*8xlarge",
                        "*10xlarge",
                        "*12xlarge",
                        "*16xlarge",
                        "*18xlarge",
                        "*24xlarge",
                        "f1.4xlarge",
                        "x1*",
                        "z1*",
                        "*metal"
                    ]
                }
            }
        },
        {
            "Sid": "PassRoleToBedrock",
            "Comment": "Allows creating IAM roles for Bedrock services with restricted scope",
            "Effect": "Allow",
            "Action": [
                "iam:PassRole",
                "iam:CreateRole",
                "iam:CreatePolicy",
                "iam:AttachRolePolicy",
                "iam:CreateServiceLinkedRole",
                "iam:PutRolePolicy"
            ],
            "Resource": "arn:aws:iam::*:role/*AmazonBedrock*",
            "Condition": {
                "StringEquals": {
                    "iam:PassedToService": [
                        "bedrock.amazonaws.com"
                    ]
                }
            }
        },
        {
            "Comment": "Allows participant to pass their own role to services",
            "Resource": "{{.ParticipantRoleArn}}",
            "Action": "iam:PassRole",
            "Effect": "Allow",
            "Sid": "PassRole"
        },
        {
            "Sid": "BedrockModelAccess",
            "Comment": "Restricted access to specific approved foundation models for workshop use",
            "Effect": "Allow",
            "Action": [
                "bedrock:InvokeModel",
                "bedrock:InvokeModelWithResponseStream",
                "bedrock:ListFoundationModelAgreementOffers",
                "bedrock:PutFoundationModelEntitlement",
                "bedrock:CreateFoundationModelAgreement"
            ],
            "Resource": [
                "arn:aws:bedrock:us-west-2::foundation-model/amazon.titan-embed-text-v1",
                "arn:aws:bedrock:us-west-2::foundation-model/amazon.titan-embed-text-v2:0",
                "arn:aws:bedrock:us-west-2::foundation-model/anthropic.claude-3-5-haiku-20241022-v1:0",
                "arn:aws:bedrock:us-west-2::foundation-model/anthropic.claude-3-5-sonnet-20241022-v2:0",
                "arn:aws:bedrock:us-west-2::foundation-model/anthropic.claude-3-7-sonnet-20250219-v1:0",
                "arn:aws:bedrock:us-west-2::foundation-model/amazon.nova-*"
            ]
        },
        {
            "Sid": "DenyBedrockModelAccessForOtherModels",
            "Comment": "Explicitly denies access to expensive or restricted foundation models",
            "Effect": "Deny",
            "Action": [
                "bedrock:InvokeModel",
                "bedrock:InvokeModelWithResponseStream",
                "bedrock:ListFoundationModelAgreementOffers",
                "bedrock:PutFoundationModelEntitlement",
                "bedrock:CreateFoundationModelAgreement"
            ],
            "Resource": [
                "arn:aws:bedrock:us-west-2::foundation-model/anthropic.claude-3-opus-20240229-v1:0",
                "arn:aws:bedrock:us-west-2::foundation-model/anthropic.claude-3-sonnet-20240229-v1:0",
                "arn:aws:bedrock:us-west-2::foundation-model/anthropic.claude-3-haiku-20240307-v1:0",
                "arn:aws:bedrock:us-west-2::foundation-model/anthropic.claude-sonnet-4-20250514-v1:0",
                "arn:aws:bedrock:us-west-2::foundation-model/anthropic.claude-v2:1",
                "arn:aws:bedrock:us-west-2::foundation-model/anthropic.claude-v2",
                "arn:aws:bedrock:us-west-2::foundation-model/anthropic.claude-instant-v1",
                "arn:aws:bedrock:us-west-2::foundation-model/meta*",
                "arn:aws:bedrock:us-west-2::foundation-model/mistral*",
                "arn:aws:bedrock:us-west-2::foundation-model/cohere.*",
                "arn:aws:bedrock:us-west-2::foundation-model/stability*",
                "arn:aws:bedrock:us-west-2::foundation-model/amazon.titan-image-*",
                "arn:aws:bedrock:us-west-2::foundation-model/amazon.titan-embed-image-v1"
            ]
        },
        {
            "Sid": "BedrockAgentCoreLabAccess",
            "Comment": "FIXED: Explicit AgentCore permissions for Labs 2-4 workshop activities (removed invalid wildcards)",
            "Effect": "Allow",
            "Action": [
                "bedrock-agentcore:CreateMemory",
                "bedrock-agentcore:UpdateMemory",
                "bedrock-agentcore:GetMemory",
                "bedrock-agentcore:ListMemories",
                "bedrock-agentcore:CreateGateway",
                "bedrock-agentcore:CreateGatewayTarget",
                "bedrock-agentcore:GetGateway",
                "bedrock-agentcore:ListGateways",
                "bedrock-agentcore:CreateAgentRuntime",
                "bedrock-agentcore:UpdateAgentRuntime",
                "bedrock-agentcore:GetAgentRuntime",
                "bedrock-agentcore:ListAgentRuntimes",
                "bedrock-agentcore:InvokeAgentRuntime",
                "bedrock-agentcore:ListSessions",
                "bedrock-agentcore:CreateEvent",
                "bedrock-agentcore:GetEvent",
                "bedrock-agentcore:RetrieveMemoryRecords",
                "bedrock-agentcore:ListMemoryRecords",
                "bedrock-agentcore:AllowVendedLogDeliveryForResource"
            ],
            "Resource": "*",
            "PermissionDetails": {
                "bedrock-agentcore:CreateMemory": "Lab 2: Create CustomerSupportMemory resource for customer preferences",
                "bedrock-agentcore:UpdateMemory": "Lab 2: Update memory configuration and strategies",
                "bedrock-agentcore:GetMemory": "Lab 4: View memory resource details for observability",
                "bedrock-agentcore:ListMemories": "Lab 4: List all memory resources in observability views",
                "bedrock-agentcore:CreateGateway": "Lab 3: Create customersupport-gw gateway for tool sharing",
                "bedrock-agentcore:CreateGatewayTarget": "Lab 3: Add tools (warranty, web search, product info) to gateway",
                "bedrock-agentcore:GetGateway": "Lab 4: View gateway details for observability",
                "bedrock-agentcore:ListGateways": "Lab 4: List all gateways in observability views",
                "bedrock-agentcore:CreateAgentRuntime": "Lab 4: Deploy customer_support_agent to runtime",
                "bedrock-agentcore:UpdateAgentRuntime": "Lab 4: Update runtime configuration",
                "bedrock-agentcore:GetAgentRuntime": "Lab 4: View runtime details for observability",
                "bedrock-agentcore:ListAgentRuntimes": "Lab 4: List all runtimes in observability views",
                "bedrock-agentcore:InvokeAgentRuntime": "Lab execution: Invoke the deployed agent",
                "bedrock-agentcore:ListSessions": "Lab 4.1: View sessions in GenAI Observability dashboard",
                "bedrock-agentcore:CreateEvent": "Memory operations: Create events for conversation context",
                "bedrock-agentcore:GetEvent": "Memory operations: Retrieve event details",
                "bedrock-agentcore:RetrieveMemoryRecords": "Memory operations: Retrieve stored memories",
                "bedrock-agentcore:ListMemoryRecords": "Memory operations: List memory records",
                "bedrock-agentcore:AllowVendedLogDeliveryForResource": "Lab 4.4: CRITICAL - Enable Memory/Gateway log delivery to CloudWatch (fixes WSParticipantRole permission error)"
            }
},
        {
            "Sid": "ObservabilityNote",
            "Comment": "NOTE: CloudWatch observability permissions (logs:*, xray:*, cloudwatch:*, application-signals:*) are provided by wildcards in AllReaperSupportedServices statement above. Lab 4 functionality for CloudWatch Logs, X-Ray tracing, Application Signals, and GenAI Observability dashboard is fully supported without additional explicit permissions."
        }
    ]
}